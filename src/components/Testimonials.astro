---
// Customer reviews band. Renders nothing until src/data/testimonials.ts has
// entries, so the section can ship ahead of the client's testimonials.
//
// Deliberately no Review/AggregateRating JSON-LD: Google treats reviews a
// business publishes about itself as self-serving and they are not eligible
// for star rich results. Add the markup only if reviews start coming from a
// third-party platform.
import { testimonials } from '../data/testimonials';
import { link } from '../lib/url';

const items = testimonials;
---

{
  items.length > 0 && (
    <section class="bg-navy py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <p class="text-gold font-medium uppercase tracking-widest text-sm mb-2">Testimonials</p>
          <h2 class="font-heading font-bold text-3xl md:text-4xl text-white">
            What Our Neighbors Say
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((t) => (
            <figure class="flex h-full flex-col rounded-xl bg-navy-dark border border-navy-light p-8">
              <svg
                class="h-8 w-8 text-gold/40 mb-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M9.6 5.4A7.6 7.6 0 0 0 4 12.8V19h6.4v-6.4H7.2c0-2.3 1.3-3.9 3.4-4.4zm9.6 0a7.6 7.6 0 0 0-5.6 7.4V19H20v-6.4h-3.2c0-2.3 1.3-3.9 3.4-4.4z" />
              </svg>

              {t.rating && (
                <div class="flex gap-1 mb-4" role="img" aria-label={`${t.rating} out of 5 stars`}>
                  {Array.from({ length: 5 }, (_, i) => (
                    <svg
                      class={i < t.rating ? 'h-5 w-5 text-gold' : 'h-5 w-5 text-navy-light'}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                      aria-hidden="true"
                    >
                      <path d="M10 15.3l-5.1 2.9 1.2-5.8L1.8 8.3l5.9-.6L10 2.3l2.3 5.4 5.9.6-4.3 4.1 1.2 5.8z" />
                    </svg>
                  ))}
                </div>
              )}

              <blockquote class="flex-1 text-gray-200 leading-relaxed">{t.quote}</blockquote>

              <figcaption class="mt-6 pt-6 border-t border-navy-light">
                <p class="font-heading font-bold text-white">{t.author}</p>
                {(t.location || t.service) && (
                  <p class="text-gray-400 text-sm mt-1">
                    {[t.service, t.location].filter(Boolean).join(' · ')}
                  </p>
                )}
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="text-center mt-12">
          <a
            href={link('/contact')}
            class="inline-block bg-gold hover:bg-gold-bright text-navy-dark font-bold px-8 py-3 rounded-lg transition-colors"
          >
            Get Your Free Estimate
          </a>
        </div>
      </div>
    </section>
  )
}
